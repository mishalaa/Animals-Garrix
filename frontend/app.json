{
  "expo": {
    "name": "PetPassport",
    "slug": "petpassport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach photos of vet reports and your pet.",
        "NSCameraUsageDescription": "Take photos of vet reports and your pet."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDEDE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      "expo-sharing",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#E8705F"
        }
      ]
    ],
    "scheme": "petpassport"
  }
}
